# Configure these in the hosting dashboard. Never commit real values.
APP_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ACCESS_PASSWORD=replace-with-your-owner-password
# DATABASE_URL=postgresql://user:password@host/database
# Only for local development, never on Render:
# ACCOUNTS_SQLITE_PATH=.local-data/accounts.sqlite
# Cloud project and image sync is opt-in, after choosing permanent storage:
CLOUD_STORAGE_ENABLED=false
